datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  datasets     Dataset[]
  reports      Report[]
}

model Dataset {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  filename         String
  fileSizeBytes    Int
  rowCount         Int          @default(0)
  unparseableCount Int          @default(0)
  columns          String       // JSON: ColumnProfile[]
  unparseableRows  String       // JSON: UnparseableRow[]
  createdAt        DateTime     @default(now())

  rows             DatasetRow[]
  reports          Report[]

  @@index([userId])
}

model DatasetRow {
  id         String   @id @default(cuid())
  datasetId  String
  dataset    Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  rowNumber  Int
  data       String   // JSON: Record<string, any>
  isValid    Boolean  @default(true)
  parseError String?

  @@index([datasetId])
  @@index([datasetId, rowNumber])
}

model Report {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  datasetId     String
  dataset       Dataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  globalFilters String        @default("{}") // JSON: GlobalFilters
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  blocks        ReportBlock[]
  shareLinks    ShareLink[]

  @@index([userId])
  @@index([datasetId])
}

model ReportBlock {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  orderIndex Int      @default(0)
  blockType  String   // "METRIC" | "CHART" | "TABLE" | "TEXT_NOTE"
  title      String?
  config     String   // JSON: MetricConfig | ChartConfig | TableConfig | TextNoteConfig
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([reportId])
  @@index([reportId, orderIndex])
}

model ShareLink {
  id        String    @id @default(cuid())
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime?
  isRevoked Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([reportId])
}
